# SA Geospatial Feature ETL — Environment Variables
# Copy this file to .env and adjust as needed.

# Output directory for GeoJSON files (default: output)
# SA_ETL_OUTPUT_DIR=output

# Log directory (default: logs)
# SA_ETL_LOG_DIR=logs

# HTTP request timeout in seconds (default: 60)
# SA_ETL_REQUEST_TIMEOUT=60

# Maximum retry attempts per HTTP request (default: 3)
# SA_ETL_MAX_RETRIES=3

# ArcGIS token — only needed for secured services (PlanSA public layers do not require this)
# SA_ETL_TOKEN=
